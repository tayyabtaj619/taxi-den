# Copy to .env.local and adjust. Only variables prefixed with VITE_ are exposed
# to the browser, so NEVER put secrets (API keys, tokens) in them. Anything
# secret must live on the booking backend, not in this frontend.

# Booking adapter: "mock" (default, nothing is sent anywhere) or "api".
# "api" only works once src/services/booking/apiAdapter.js has been implemented
# against the client's real booking/dispatch API documentation.
VITE_BOOKING_MODE=mock

# Base URL of the client's booking API (public endpoint, no credentials).
VITE_BOOKING_API_URL=

# Customer account pages. Default: the existing pages on the live site
# (https://www.taxidenbosch.eu/login and /register). Override the base, or the
# individual URLs, when the new customer portal is built.
VITE_CUSTOMER_PORTAL_URL=
VITE_CUSTOMER_LOGIN_URL=
VITE_CUSTOMER_REGISTER_URL=

# Contact form: "handoff" (default) opens the visitor's email app or WhatsApp
# with the message prefilled; nothing is sent by the website. "api" only works
# once submitContactMessage in src/services/contact/index.js is implemented.
VITE_CONTACT_MODE=handoff

# App store links for the Snel Taxi app (see storeLinks in src/config.js).
# App Store defaults to the verified listing. Google Play defaults to the
# generic Play Store homepage until the client provides the real listing URL.
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=
